DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Root CA Supabase (unduh dari Dashboard > Database > SSL Configuration),
# encode base64 satu baris: base64 -w0 prisma/prod-ca-2021.crt
SUPABASE_CA_B64=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
LLM_PROVIDER="openai-compatible"
LLM_MODEL=""
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
