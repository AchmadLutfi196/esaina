# Public variable names only. Never commit real values.
# Supabase: unduh root CA dari Dashboard > Database Settings > SSL Configuration
# ke prisma/prod-ca-2021.crt, lalu pakai sslmode=verify-full&sslrootcert=./prisma/prod-ca-2021.crt
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=./prisma/prod-ca-2021.crt&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./prisma/prod-ca-2021.crt"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
LLM_PROVIDER="openai-compatible"
LLM_MODEL=""
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
